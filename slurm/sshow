#!/bin/bash

set -o errexit \
    -o nounset \
    -o pipefail


function check_command () {
    local cmd="$1"
    if ! command -v "$cmd" &>/dev/null; then
        >&2 \
        printf "Error: no ${cmd} found, cannot do anything"
        exit 1
     fi
}


function usage() {
    >&2 \
    printf "
%s - a wrapper around Slurm tools, to simplify common ops

Subcommands:

  account  - accounts with orgs and coordinators (sacctmgr)
  assoc    - associations with users (sacctmgr)
  qos      - qos details (sacctmgr)
  user     - usernames with their default account and admin status (sacctmgr)
  node     - nodes with their current state and load (sinfo)
  job      - current jobs (squeue)
  jobhist  - past jobs (sacct)

You can pass additional options to the underlying tools. Please refer to the
corresponding man pages.

" \
    "$(basename "$0")"
}


# shellcheck disable=SC2120
function pp () {
   local delimiter="${1-|}"
   column --table --separator "$delimiter" --output-separator ' '
}


if [[ "$#" -lt 1 ]]; then
    usage
    exit 1
fi

subcmd="$1"
shift

case "$subcmd" in
    # These are all very simple at the moment. If they get complicated, split them out into a function.
    "account")
        check_command sacctmgr
        sacctmgr --parsable2 show account \
          format='account,org,coordinators,descr' \
          "$@" | pp
        ;;
    "assoc")
        check_command sacctmgr
        sacctmgr --parsable2 show assoc \
          format='account%,user,share,maxsubmit,defaultqos,qos' \
          "$@" | pp
        ;;
    "qos")
        check_command sacctmgr
        sacctmgr --parsable2 show qos \
          format='name,priority,mintres,maxtres,maxwall,maxjobsperuser,grpjobs,maxsubmit,flags' \
          "$@" | pp
        ;;
    "user")
        check_command sacctmgr
        sacctmgr --parsable2 show user \
          format='user,defaultaccount,admin' \
          "$@" | pp
        ;;
    "node")
        check_command sinfo
        sinfo --Node \
          --format '%n|%a|%C|%O|%m|%e|%t|%E' \
          "$@" | pp
        ;;
    "jobhist")
        check_command sacct
        sacct --parsable2 --allocations --duplicates \
          --format 'jobid,user,account,qos,state,start,elapsed,nnodes,exitcode,jobname' \
          "$@" | pp
        ;;
    "job")
        check_command squeue
        squeue \
          --format '%i|%u|%a|%q|%T|%S|%M|%D|%p|%j' \
          "$@" | pp
        ;;
    *)
        # This implements something like git's handling of scripts named e.g. git-thing
        if command -v "sshow-$subcmd"; then
            exec "sshow-$subcmd" "$@"
        else
            printf "Error: unrecognised subcommand: %s\n" "$subcmd" >&2
            exit 1
        fi
        ;;
esac

